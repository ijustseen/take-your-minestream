# Copy to .env and fill in. .env is gitignored and must not be committed.
# Prefer single quotes for CurseForge token: it contains `$`.

# Modrinth project id from the project page / dashboard
MODRINTH_ID=
# Modrinth: https://modrinth.com/settings/pats
# Scopes: Create versions, Read versions, Write versions
MODRINTH_TOKEN=

# CurseForge numeric project id from the project sidebar
CURSEFORGE_ID=
# CurseForge AUTHOR upload token — must be from the LEGACY page:
# https://legacy.curseforge.com/account/api-tokens
# Not console.curseforge.com. Looks like $2a$10$...
CURSEFORGE_TOKEN=
